# 忽略各基准的原始数据文件 (CSV/tgz), 但不忽略 schema 等 SQL 源文件
benchmarks/*/data/*.csv
benchmarks/*/data/*.tgz
benchmarks/*/data/*.tar
benchmarks/*/data/*.gz
!benchmarks/*/data/*.sql

# Census 1990 大数据文件 (保留 .txt 文档, 只忽略这些超大原始数据)
benchmarks/Census/data/USCensus1990.data.txt
benchmarks/Census/data/USCensus1990raw.data.txt
benchmarks/Census/data/us+census+data+1990.zip

# Python 虚拟环境 / 缓存 / 实验输出
.venv/
__pycache__/
*.pyc
results/
output/
experiments/

# 上游 End-to-End-CardEst-Benchmark 嵌套仓库（仅作数据/参考来源，不纳入本仓库）
End-to-End-CardEst-Benchmark/

# PostgreSQL 16.14 源码包与解压目录（本地源码参考，不纳入本仓库）
postgresql-16.14.tar.bz2
postgresql-16.14/

# VLDB 论文 LaTeX 构建产物（保留 .tex/.bib/.cls/.bst/outline，忽略编译产物）
paper/*.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/comment.cut
paper/*.synctex.gz