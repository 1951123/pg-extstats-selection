# Ignore raw benchmark data files (CSV/tgz); do not ignore SQL schema sources
benchmarks/*/data/*.csv
benchmarks/*/data/*.tgz
benchmarks/*/data/*.tar
benchmarks/*/data/*.gz
!benchmarks/*/data/*.sql

# Census 1990 data — all payloads and their bundled docs come from the UCI
# dataset archive (us+census+data+1990.zip, see README); nothing under data/
# is generated by this repo, so the whole third-party data dir is ignored save
# for any repo-authored schema (*.sql).
benchmarks/Census/data/

# Python virtual env / caches / experiment output
.venv/

# Temporary analysis scripts (tmp_ prefix local drafts, not tracked)
scripts/tmp_*
__pycache__/
*.pyc

# Experiment output: results/ ignored by default, but 'paper primary artifacts'
# are whitelisted below (directly depended on by figures/numbers, expensive to
# rerun, measured data not regenerable from scripts). See the manifest in
# docs/reproducibility.md (number <-> source JSON <-> reproduction script).
output/
experiments/

# ---- paper primary artifacts (must be tracked; figures/numbers reproducible) ----
# Everything else under results/ stays ignored (smoke / temporary probes / regenerable intermediates)
# NOTE: do NOT put a trailing '# comment' on a negation (!) line -- it breaks
# gitignore parsing and the file silently stays ignored.
results/*
# Data source for the paper's figures + full RQ1 capacity axis {10..10000} (replaces old full_multi)
!results/phase1_ceb_single_mask_6level.json
# CENSUS {100,1000,10000} ~21h official baseline (30,856 candidates, incl. one resume after interruption)
!results/phase1_census_mcv_multi.json
# CENSUS low-level probe (single-col-50, historical)
!results/phase1_census_mcv_low.json
# CENSUS official rerun (single-col-10000) final data
!results/phase1_census_mcv_low_t10000.json
# CENSUS full six-level axis [10,25,50,100,1000,10000] (merged low/high by merge_phase1.py)
!results/phase1_census_mcv_6level.json
# CENSUS six-level budget-quality metrics (Fig:census_budget_quality data source)
!results/p3_census_metrics.json
# stats_CEB six-level budget-quality metrics (Fig:budgetquality data source)
!results/p3_metrics.json
# RQ3 six-level recomputed results (tab:greedy2/whathowmuch/ablation/meanrob sources)
!results/p6_greedy_strong.json
!results/p2_what_vs_howmuch.json
!results/p5_ablation_5k.json
!results/p5_ablation_100k.json
!results/p10_mean_robustness.json
# sec:measure-runtime single-query six-level T_q(b) measurements (query.3 CENSUS + st.144 stats_CEB_single)
!results/tq6_model_vs_measured.json
!results/tq6_stats_ceb_model_vs_measured.json
!results/tq6_full.log
!results/tq6_stats_ceb.log
!results/tq6_smoke.json
!results/tq6_smoke.log
# stats_CEB mcv measurement & reproduction
!results/phase1_stats_ceb_mcv.json
!results/phase1_stats_ceb_mcv_r3.json
# Protocol-M vs True-L sampling-mismatch validation (scripts/validate_true_vs_mask.py output)
!results/true_vs_mask_smoke.json
!results/true_vs_mask_pilot.json
!results/true_vs_mask_census.json
!results/true_vs_mask_posts144.json
# Protocol-M applicability boundary scan (scripts/tmp_boundary_scan.py output)
!results/boundary_scan.json
# λ transition curves (scripts/tmp_transition_*.py output: data + plots)
!results/transition_query184.json
!results/transition_multicand.json
!results/transition_query184.png
!results/transition_multicand.png
# Official phase-1 run logs (config/progress, auditability)
!results/phase1_ceb_single_6level.log
!results/phase1_census_low.log
!results/phase1_census_low_t10000.log
!results/phase1_census_mcv_multi.log
!results/probe_census_fine_capacity.log

# Upstream End-to-End-CardEst-Benchmark nested repo (data/reference source only, not tracked)
End-to-End-CardEst-Benchmark/

# PostgreSQL 16.14 source tarball & extracted dir (local source reference, not tracked)
postgresql-16.14.tar.bz2
postgresql-16.14/

# VLDB paper LaTeX build artifacts (keep .tex/.bib/.cls/.bst; ignore build outputs)
paper/*.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/comment.cut
paper/*.synctex.gz

# Official VLDB template download zip (source archive, not tracked; template files extracted into paper/)
Official_VLDB_Template.zip
