{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Generate Candidates (census, dry-run)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_candidates.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["--bench", "census", "--dry-run", "--no-verbose-ddl"]
        },
        {
            "name": "Generate Candidates (current bench, dry-run)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_candidates.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["--dry-run", "--no-verbose-ddl"]
        },
        {
            "name": "Generate Candidates (all, real create)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_candidates.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PGPASSWORD": ""
            }
        }
    ]
}